{
  "include": [
    "src",
    "tests",
    "api",
    "scripts"
  ],
  "exclude": [
    "notebooks",
    "web",
    "**/node_modules",
    "**/.pytest_cache",
    "**/.ruff_cache"
  ],
  "extraPaths": [
    "."
  ],
  "typeCheckingMode": "basic",
  "reportMissingImports": "warning",
  "reportMissingTypeStubs": false,
  "reportUnnecessaryCast": false,
  "executionEnvironments": [
    {
      "root": "notebooks",
      "typeCheckingMode": "off",
      "extraPaths": ["."]
    }
  ]
}
