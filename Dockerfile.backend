# ==============================================================================
# ReadmitIQ - Backend Containerfile
# Python 3.12 slim with LightGBM, FAISS, and FastAPI
# ==============================================================================

FROM python:3.12-slim AS base

# System dependencies for LightGBM, OpenMP, and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
COPY requirements.txt pyproject.toml ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application source code, config, models, and scripts
COPY api/ api/
COPY src/ src/
COPY configs/ configs/
COPY models/final/ models/final/
COPY models/FROZEN_SELECTION.json models/
COPY reports/ reports/
COPY scripts/ scripts/

# Set environment defaults
ENV PYTHONUNBUFFERED=1 \
    READMITIQ_SERVE_MODE=full \
    API_HOST=0.0.0.0 \
    API_PORT=8000 \
    PORT=8000

EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run FastAPI backend via Uvicorn
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
