# ==============================================================================
# ReadmitIQ Environment Configuration
# Ready for direct import into Render.com and Vercel
# ==============================================================================

# Serving Mode: 'lite' for Render Free Tier (<512MB RAM) or 'full' for >=1GB RAM
READMITIQ_SERVE_MODE=lite

# API Server Network Binding
API_HOST=0.0.0.0
API_PORT=8000
PORT=8000
WORKERS=1
ENVIRONMENT=production
LOG_LEVEL=INFO

# Database Auto-Seeding (seeds demo encounters in background if empty)
READMITIQ_AUTO_SEED=true

# Cross-Origin Resource Sharing (allowed frontend origins)
CORS_ORIGINS=https://readmit-iq.vercel.app,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Custom Artifact & Log Directories (repo-relative defaults)
READMITIQ_MODELS_DIR=models
READMITIQ_REPORTS_DIR=reports
READMITIQ_LOG_DIR=api/logs

# Web Frontend API Base URL (consumed by Vite SPA on Vercel)
VITE_API_BASE_URL=https://readmitiq-wlw1.onrender.com
