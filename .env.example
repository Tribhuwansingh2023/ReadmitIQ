# ==============================================================================
# ReadmitIQ Environment Configuration
# ==============================================================================

# Serving Mode: 'full' (default, 69k-patient FAISS index) or 'lite' (5k-prototype index for <512MB RAM)
READMITIQ_SERVE_MODE=full

# API Server Network Binding
API_HOST=0.0.0.0
API_PORT=8000
PORT=8000
WORKERS=2
ENVIRONMENT=production
LOG_LEVEL=INFO

# Cross-Origin Resource Sharing (comma-separated list of allowed web origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://your-frontend.vercel.app

# Custom Artifact & Log Directories (defaults to repo-relative paths)
READMITIQ_MODELS_DIR=models
READMITIQ_REPORTS_DIR=reports
READMITIQ_LOG_DIR=api/logs

# Web Frontend Environment (consumed by Vite SPA at build / runtime)
VITE_API_BASE_URL=http://localhost:8000
